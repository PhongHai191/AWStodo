global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: node_exporter
    ec2_sd_configs:
      - region: {{ aws_region }}
        filters:
          - name: tag:Role
            values: [web]
          - name: tag:Environment
            values: [{{ deploy_env }}]
          - name: instance-state-name
            values: [running]
    relabel_configs:
      - source_labels: [__meta_ec2_private_ip]
        target_label: __address__
        replacement: "$1:9100"
      - source_labels: [__meta_ec2_tag_Name]
        target_label: instance
    metric_relabel_configs:
      - source_labels: [instance]
        target_label: nodename

  - job_name: cadvisor
    ec2_sd_configs:
      - region: {{ aws_region }}
        filters:
          - name: tag:Role
            values: [web]
          - name: tag:Environment
            values: [{{ deploy_env }}]
          - name: instance-state-name
            values: [running]
    relabel_configs:
      - source_labels: [__meta_ec2_private_ip]
        target_label: __address__
        replacement: "$1:8080"
      - source_labels: [__meta_ec2_tag_Name]
        target_label: instance

  - job_name: app_metrics
    ec2_sd_configs:
      - region: {{ aws_region }}
        filters:
          - name: tag:Role
            values: [web]
          - name: tag:Environment
            values: [{{ deploy_env }}]
          - name: instance-state-name
            values: [running]
    metrics_path: /metrics
    relabel_configs:
      - source_labels: [__meta_ec2_private_ip]
        target_label: __address__
        replacement: "$1:3000"
      - source_labels: [__meta_ec2_tag_Name]
        target_label: instance

  - job_name: postgres
    static_configs:
      - targets: ["postgres_exporter:9187"]

  - job_name: redis
    static_configs:
      - targets: ["redis_exporter:9121"]
