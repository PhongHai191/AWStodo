# Terraform state files – never commit these
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform variable files with secrets – never commit
terraform.tfvars
*.auto.tfvars

# Terraform working directories
.terraform/
.terraform.lock.hcl

# Crash log files
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration
.terraformrc
terraform.rc

# Sensitive outputs
output.json
